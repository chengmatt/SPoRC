.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

# Build artifacts
inst/doc
/doc/
/Meta/
docs

# Development scratch and generated output, none of which the package needs.
# dev/dev_output is otherwise tracked, so only the regenerable bridge fits are
# ignored there.
/dev/scratch
/dev/dev_output/*_bridge.rds
/dev/rex_bridge/output/*.rds
/dev/rex_bridge/output/*.log
/dev/overnight
/dev/YFT_bridge

# Fitted model objects under paper_projects are regenerable from the scripts
# that produce them, and are large enough to bloat the pack on every re-run.
/dev/paper_projects/**/pol_models_re.RDS
/dev/goa_rex_ss3_to_sporc
/dev/rex_2021
/dev/rex_projections
dev/design_age_disaggregated_observations.md
/dev/cbh_bridge
/dev/dev_data/central_baltic_herring
/dev/spatial_sandeel
